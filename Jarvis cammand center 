        "# 1. Install Dependencies\n",
        "!pip install buildozer\n",
        "!sudo apt install -y git zip unzip openjdk-17-jdk python3-pip autoconf libtool pkg-config zlib1g-dev libncurses5-dev libtinfo5 cmake libffi-dev libssl-dev\n",
        "\n",
        "# 2. Setup Project\n",
        "!mkdir -p jarvis_app\n",
        "%cd jarvis_app\n",
        "\n",
        "# Create main.py\n",
        "with open(\"main.py\", \"w\") as f:\n",
        "    f.write(\"\"\"\n",
        "from kivy.app import App\n",
        "from kivy.uix.floatlayout import FloatLayout\n",
        "from kivy.uix.camera import Camera\n",
        "from kivy.uix.label import Label\n",
        "\n",
        "class JarvisUI(FloatLayout):\n",
        "    def __init__(self, **kwargs):\n",
        "        super().__init__(**kwargs)\n",
        "        self.cam = Camera(play=True, resolution=(640, 480))\n",
        "        self.add_widget(self.cam)\n",
        "        self.log = Label(text=\"[SYSTEM ACTIVE]\\nVOICE-CONTROL: ONLINE\", size_hint=(0.8, 0.2), pos_hint={'center_x': 0.5, 'y': 0.1}, color=(0, 0.8, 1, 1))\n",
        "        self.add_widget(self.log)\n",
        "\n",
        "class JARVISApp(App):\n",
        "    def build(self):\n",
        "        return JarvisUI()\n",
        "\n",
        "if __name__ == '__main__':\n",
        "    JARVISApp().run()\n",
        "\"\"\")\n",
        "\n",
        "# 3. Create buildozer.spec\n",
        "with open(\"buildozer.spec\", \"w\") as f:\n",
        "    f.write(\"\"\"\n",
